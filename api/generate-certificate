// /api/generate-certificate.js
// Sayt (yoki boshqa tizim) test/attestatsiya yakunlangach shu manzilga
// POST so'rov yuboradi — bot avtomatik sertifikat rasmini yaratib,
// foydalanuvchiga Telegram orqali yuboradi.
//
// So'rov formati (JSON body):
//   {
//     "telegram_id": 123456789,     // MAJBURIY — kimga yuborish
//     "name": "Ozodbek Obidov",     // MAJBURIY — sertifikatdagi ism
//     "score": "92/100",            // MAJBURIY — natija (matn yoki son)
//     "test_name": "Attestatsiya yakuniy testi"  // ixtiyoriy
//   }
// Header: Authorization: Bearer <CERT_SECRET>
//
// KERAKLI MUHIT O'ZGARUVCHILARI: TELEGRAM_BOT_TOKEN, CERT_SECRET

const { renderCertificatePng, sendCertificatePhoto, formatDate } = require('../lib/certificate');

module.exports = async (req, res) => {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Faqat POST so\'rov qabul qilinadi' });
  }

  try {
    const CERT_SECRET = process.env.CERT_SECRET;
    const authHeader = req.headers['authorization'] || '';
    if (CERT_SECRET && authHeader !== `Bearer ${CERT_SECRET}`) {
      return res.status(401).json({ error: 'Ruxsat yo\'q' });
    }

    const { telegram_id, name, score, test_name } = req.body || {};
    if (!telegram_id || !name || score == null) {
      return res.status(400).json({ error: 'telegram_id, name va score majburiy' });
    }

    const BOT_TOKEN = process.env.TELEGRAM_BOT_TOKEN;
    const dateStr = formatDate(new Date());

    const png = await renderCertificatePng({ name, score, testName: test_name, dateStr });

    const result = await sendCertificatePhoto(
      BOT_TOKEN,
      telegram_id,
      png,
      `🎉 Tabriklaymiz, ${name}! Sertifikatingiz tayyor.`
    );

    if (!result.ok) {
      return res.status(500).json({ error: 'Telegram\'ga yuborishda xatolik', details: result });
    }

    return res.status(200).json({ ok: true });
  } catch (e) {
    console.error('generate-certificate xatolik:', e);
    return res.status(500).json({ error: 'Kutilmagan server xatoligi' });
  }
};
